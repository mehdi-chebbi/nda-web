# Docker Compose Environment Variables
# Copy this file to .env and update values before running: docker-compose up

# JWT Secret - CHANGE THIS IN PRODUCTION!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-123456

# AI Configuration
# Get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Database Configuration (optional, defaults are set in docker-compose.yml)
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=eritrea_readiness
# DB_USER=postgres
# DB_PASSWORD=postgres
